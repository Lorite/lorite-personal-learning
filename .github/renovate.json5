// Hey Friendly Face reading this :)
// This is the configuration file for Renovate, a GitHub App that can automate dependency updates.

// If you're here, you're probably looking to:
// (1) Make updates for a dependency fully automated. Whitelist it at <TAG0>
// (2) Add CI. Remove "requiredStatusChecks", below.
// (3) Customize Renovate behavior further.
// For docs, see: https://docs.renovatebot.com/configuration-options/
// To debug, it can be helpful to looks at Renovate's runs/logs: https://developer.mend.io/[platform]/hedronvision/bazel-cc-filesystem-backport
// This file is .json5, so we can have helpful comments, like this one :) [Normal JSON, Renovate's default, has no comments.]
// (4) Learn about what's going on here and what Renovate can do. Read on :)
// If you need more help, contact @cpsauer.

{
  assignees: ["Lorite"],
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  enabled: true,
  labels: ["type:dependencies"],
  prConcurrentLimit: 0,
  prHourlyLimit: 1,
  rangeStrategy: "pin",
  dependencyDashboard: true,
  dependencyDashboardHeader: "Organization members: Check Renovate logs here: https://developer.mend.io/github/Lorite/lorite-personal-learning",
  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      matchDepTypes: ["devDependencies"],
      automerge: true,
    },
    {
      // One pull request for all Bazel module updates: every MODULE.bazel change rewrites MODULE.bazel.lock,
      // so separate PRs conflict with each other after the first merge (24 stale PRs on 2026-10-14).
      matchManagers: ["bazel-module"],
      groupName: "bazel modules",
    },
    {
      // Platform majors are deliberate migrations, not routine updates: the Bazel major (9.x broke .bazelrc
      // flags) and the CI runner image. Minor and patch updates still flow.
      matchDepNames: ["bazel", "ubuntu"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // The Python version is a deliberate migration too, but Renovate counts 3.13 -> 3.15 as a minor update,
      // so a "major" rule never matched it, and the "pin" range strategy turned requires-python "==3.13.*" into
      // a single patch release. Renovate leaves the Python version alone.
      matchDepNames: ["python"],
      enabled: false,
    },
  ],
  platformAutomerge: true,
  // The CI formatter bot commits on Renovate branches (formatting, regenerated Python lock files). Without this,
  // Renovate treats every such branch as edited by a human and stops updating it (9 pull requests were stuck that way).
  gitIgnoredAuthors: ["code-formatter-bot[bot]@users.noreply.github.com"],
  // The requirements.txt files are pip-compile outputs that Bazel regenerates (bazel run <pkg>:requirements.update -- --upgrade)
  // and verifies (<pkg>:requirements_test). A single-line edit by Renovate never matches a fresh compile, so every pip pull
  // request failed CI. The weekly python-locks workflow regenerates them instead.
  pip_requirements: { enabled: false },
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "src/subrepos/**",
    "tools/git/git-subrepo/**",
  ],
}
