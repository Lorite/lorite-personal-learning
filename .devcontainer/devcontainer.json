{
  "name": "Lorite Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04", // Any generic, debian-based image. Pinned to the LTS: the floating "ubuntu" tag moved to 26.04 (resolute) in 2026-10, where the docker-in-docker feature cannot install moby.
  "features": {
    "ghcr.io/devcontainers-contrib/features/zsh-plugins:0": {
      "plugins": "git zsh-autosuggestions zsh-syntax-highlighting",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions https://github.com/zsh-users/zsh-syntax-highlighting"
    },
    "ghcr.io/balazs23/devcontainers-features/bazel:1": {
      "bazelisk": "v1.25.0"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "23",
      "jdkDistro": "mandrel",
      "installGradle": false,
      "installMaven": false,
      "installAnt": false,
      "installGroovy": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}, // uv, Python package and project manager, used by src/courses-free/probabilistic_robotics
    "ghcr.io/devcontainers/features/python:1": {
      // The distribution's python3 only. Bazel's own helper scripts (rules_python console-script generator, bazel_latex latexrun, rules_lint format.bash) start with "#!/usr/bin/env python3" and fail with exit 127 without it. Project code uses the Bazel-managed interpreter or uv.
      "version": "os-provided",
      "installTools": false
    }
  },
  "customizations": {
    "vscode": {
      // TODO: check which vscode extensions we should include in the container
      "extensions": [
        "github.vscode-github-actions",
        "ms-python.python", // Python language support, used by the Jupyter notebooks of the Probabilistic Robotics course
        "ms-toolsai.jupyter", // run .ipynb notebooks inside VS Code
        // "ms-azuretools.vscode-docker", // installed by feature ghcr.io/devcontainers/features/docker-in-docker:4
        "eamodio.gitlens",
        // "ms-python.python",  # installed by feature ghcr.io/devcontainers/features/python:1
        // "ms-python.vscode-pylance",  # installed by feature ghcr.io/devcontainers/features/python:1
        "vadimcn.vscode-lldb",
        "usernamehw.errorlens", // show errors inline
        "chrischinchilla.vale-vscode", // linting for writing
        "esbenp.prettier-vscode", // formatting for some languages
        "hediet.debug-visualizer", // visualize data structures while debugging
        // "ms-vscode.cpptools",
        // "twxs.cmake",
        // "DotJoshJohnson.xml",
        // "docsmsft.docs-yaml",
        // "mutantdino.resourcemonitor",
        // "lextudio.restructuredtext",
        // "foxundermoon.shell-format",
        // "timonwong.shellcheck",
        // "dtangren.vs-codeowners",
        "llvm-vs-code-extensions.vscode-clangd",
        "CS128.cs128-clang-tidy",
        // "docsmsft.docs-markdown",
        // "humao.rest-client",
        // "trond-snekvik.simple-rst",
        // "heptio.jsonnet",
        // "redhat.ansible",
        // "xrc-inc.jsonnet-formatter",
        // "zxh404.vscode-proto3",
        "bazelbuild.vscode-bazel",
        // "ryanluker.vscode-coverage-gutters",
        "cschlosser.doxdocgen", // doxygen documentation generator for C++
        // "sonarsource.sonarlint-vscode",
        // "Huuums.vscode-fast-folder-structure",
        // "vadimcn.vscode-lldb",
        // "rust-lang.rust-analyzer",
        "huibizhang.codesnap-plus",
        "wmaurer.change-case",
        // "Guyutongxue.cpp-reference",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        // "golang.go", // installed by feature ghcr.io/devcontainers/features/go:1
        // "ms-vsliveshare.vsliveshare",
        // "shd101wyy.markdown-preview-enhanced",
        // "analytic-signal.preview-mp4",
        "avaly.restore-git-branch-tabs-improved",
        "valsorym.smart-tabs",
        // "yy0931.save-as-root",
        "awtnb.spotline",
        "shyykoserhiy.vscode-spotify",
        "patricklee.vsnotes",
        "WakaTime.vscode-wakatime",
        // "redhat.vscode-yaml",
        // "tomoki1207.pdf",
        "bierner.markdown-emoji",
        "bierner.emojisense",
        "rioj7.command-variable" // Command Variable for running bazel debug configurations
      ],
      "settings": {
        "editor.tabCompletion": "on",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.fontFamily": "MesloLGS NF",
        "git.autofetch": true,
        "git.autofetchPeriod": 60
      }
    }
  },

  "forwardPorts": [8888], // JupyterLab of src/courses-free/probabilistic_robotics (uv run jupyter lab)
  "postCreateCommand": "./.devcontainer/postCreateCommand.sh",
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "remoteUser": "vscode",
  "containerUser": "vscode"
}
